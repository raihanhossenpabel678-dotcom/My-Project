rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    // Bids collection
    match /bids/{bidId} {
      allow read: if true;
      allow write: if true;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
